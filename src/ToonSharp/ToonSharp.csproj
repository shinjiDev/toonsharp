<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>ToonLib</PackageId>
    <Version>1.3.0</Version>
    <Authors>Christian Palomares</Authors>
    <Company>ToonSharp Contributors</Company>
    <Description>A production-grade C# library for converting data between JSON, YAML, TOML, and TOON (Token-Oriented Object Notation) with full TOON SPEC v2.0 compliance. Features YAML/TOML bidirectional conversion, parallel processing, Span&lt;T&gt; optimizations, automatic tabular detection, and significant performance improvements. Perfect for cross-ecosystem configuration management (Rust Cargo.toml, Python pyproject.toml).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shinjiDev/toonsharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shinjiDev/toonsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>toon;json;yaml;toml;serialization;parser;data-format;token-optimized;toon-spec;dotnet;csharp;yaml-converter;toml-converter;cargo;pyproject</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
